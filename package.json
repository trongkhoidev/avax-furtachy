{
  "name": "futara",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "pnpm --filter @futara/web dev",
    "dev:stack": "turbo dev",
    "dev:fuji": "sh -c 'set -a; . ./.env; set +a; turbo dev'",
    "db:up": "docker compose up -d postgres",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "contracts:build": "cd packages/contracts && forge build",
    "deploy:fuji": "sh -c 'set -a; . ./.env; set +a; cd packages/contracts && forge script script/Deploy.s.sol:Deploy --rpc-url fuji --broadcast --slow'",
    "test": "pnpm contracts:test && pnpm --filter @futara/agents test && pnpm --filter @futara/api test",
    "contracts:test": "cd packages/contracts && forge test --offline"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "codegraph": "^1.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.3.0",
    "@openzeppelin/contracts-upgradeable": "5.3.0"
  }
}
